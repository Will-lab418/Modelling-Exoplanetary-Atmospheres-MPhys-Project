! Namelist file for the tutorial pt_eq: 1D radiative-convective equilibrium profile (with equilibrium chemistry)
! This example sets the parameters for WASP-39b

&UNITS
/

&PARAM 
Debug  = 0
fout = 'wasp39b_pt_eq.ncdf'
/

&EOS gamma = 0./

&GRID 
logg   = 2.63
teff   = 100.
tinit  = 1075.
isothermal = f
ndepth = 50
pmin = 1E-5
pmax = 1E2
Rp = 1.28

taumin = 2E-6
taumax = 5E4
check_tau = t
mod_tau = 5

corr_k = t
/

&CHEMISTRY 
chem  = 'eq' 
fAin = 'chem_dummy.ncdf'
fAeqout = 'chem_wasp39b_pt_eq.ncdf'
print_chem = f
/

&CHEM_NEQ
/

&RADTRANS nrays = 16
scatter = t
irrad = t
firad='WASP39.ncdf' 
rstar = 0.939 
rorbit = 0.048
fred = 0.5
ftau_top = 1
murad = 0.5
/

&CHEM_RELAX
/

&OPACITY 
nkap =12
/

&SOLVER 
solve_hydro  = t
solve_energy = t
minstep      = 1.0E-1
maxstep      = 9.0E-1
accuracy     = 1.0E-3
psurf        = 1E-5
print_err = f
/
 
&CONVECTION alpha = 1.5/
